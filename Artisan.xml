    <Button name="ArtisanSkillButtonTemplate" inherits="ClassTrainerSkillButtonTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <FontString name="$parentCost" inherits="GameFontNormal">
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset x="-5" y="0"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                <Texture name="$parentIcon">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset x="13" y="0"/>
                        </Anchor>
                    </Anchors>
                    <TexCoords left="0.078125" right="0.90625" top="0.078125" bottom="0.90625"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString name="$parentCount" inherits="GameFontNormal">
                    <Size x="0" y="13"/>
                    <Anchors>
                        <Anchor point="LEFT"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick>
                Artisan.SkillButton_OnClick(this, arg1)
            </OnClick>
            <OnLeave>
                if Artisan.selectedSkill ~= this:GetID() then
                    _G[this:GetName().."SubText"]:SetTextColor(this.r, this.g, this.b)
                    _G[this:GetName().."Cost"]:SetTextColor(this.r, this.g, this.b)
                end
            </OnLeave>
            <OnEnter>
                _G[this:GetName().."SubText"]:SetTextColor(HIGHLIGHT_FONT_COLOR.r, HIGHLIGHT_FONT_COLOR.g, HIGHLIGHT_FONT_COLOR.b)
                _G[this:GetName().."Cost"]:SetTextColor(HIGHLIGHT_FONT_COLOR.r, HIGHLIGHT_FONT_COLOR.g, HIGHLIGHT_FONT_COLOR.b)
            </OnEnter>
        </Scripts>
    </Button>
    <Button name="ArtisanReagentTemplate" inherits="TradeSkillItemTemplate" virtual="true">
