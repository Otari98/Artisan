        <Scripts>
            <OnLoad>
                Artisan.OnLoad(this)
            </OnLoad>
            <OnEvent>
                Artisan.OnEvent(this, event, arg1)
            </OnEvent>
            <OnUpdate>
                Artisan.OnUpdate(this, arg1)
            </OnUpdate>
            <OnShow>
                ArtisanFrameInputBox:SetNumber(1)
                PlaySound("igCharacterInfoOpen")
            </OnShow>
            <OnHide>
                Artisan.currentTab = nil
                CloseTradeSkill()
                CloseCraft()
                ArtisanEditor:Hide()
                PlaySound("igCharacterInfoClose")
            </OnHide>
            <OnMouseWheel>
                return
            </OnMouseWheel>
            <OnMouseDown>
                Artisan.OnMouseDown(this, arg1)
            </OnMouseDown>
            <OnMouseUp>
                Artisan.OnMouseUp(this, arg1)
            </OnMouseUp>
        </Scripts>
