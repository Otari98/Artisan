                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentLeft" file="Interface\Common\Common-Input-Border">
                            <Size x="8" y="20"/>
                            <Anchors>
                                <Anchor point="TOPLEFT">
                                    <Offset x="-5" y="0"/>
