                                </Anchor>
                            </Anchors>
                        </PushedTexture>
                        <Scripts>
                            <OnClick>
                                local box = this:GetParent()
                                box:ClearFocus()
                                if box:GetText() == "" then return end
                                box:SetText("")
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
                <Scripts>
                    <OnEnterPressed>
                        this:ClearFocus()
                    </OnEnterPressed>
                    <OnTextChanged>
                        Artisan.TradeSkillFilter_OnTextChanged(this)
                    </OnTextChanged>
                    <OnEscapePressed>
                        this:SetText("")
                        this:ClearFocus()
                    </OnEscapePressed>
                    <OnEditFocusLost>
                        this:HighlightText(0, 0)
                        if string.len(this:GetText()) > 0 then
                            this:AddHistoryLine(this:GetText())
                        end
                    </OnEditFocusLost>
                    <OnEditFocusGained>
                        this:HighlightText()
                    </OnEditFocusGained>
