                        <Offset x="-85" y="0"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        if Artisan.numAvailable and Artisan.IsTradeSkill() then
                            local skill, trueSkill = Artisan.GetTradeSkillSelectionIndex()
                            ArtisanFrameInputBox:SetNumber(Artisan.numAvailable)
                            DoTradeSkill(trueSkill, Artisan.numAvailable)
                            ArtisanFrameInputBox:ClearFocus()
                        end
                    </OnClick>
                </Scripts>
            </Button>
